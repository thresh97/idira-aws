+SECRET_CMD_VARS = {'OATH': 'AWSLOGIN_OTP_CMD', 'UP': 'AWSLOGIN_PASSWORD_CMD'}
+
+def read_mech_secret(mechanism):
+    name = mechanism.get('Name')
+    var = SECRET_CMD_VARS.get(name)
+    cmd = os.environ.get(var, '').strip() if var else ''
+    if cmd:
+        try:
+            out = subprocess.run(shlex.split(cmd), stdout=subprocess.PIPE, check=True, timeout=60).stdout.decode().rstrip('\r\n')
+        except (OSError, ValueError, subprocess.SubprocessError):
+            print(Fore.RED + var + " failed; enter it manually." + Style.RESET_ALL)
+        else:
+            if name == 'OATH':
+                out = out.strip()
+            if out and (name != 'OATH' or re.fullmatch(r'\d{6,8}', out)):
+                return out
+            print(Fore.RED + var + " did not print a usable value; enter it manually." + Style.RESET_ALL)
+    return getpass(mech_label(mechanism) + " : ")
 
